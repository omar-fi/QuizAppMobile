<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".quiz1"
    android:orientation="vertical"
    android:background="@color/black"
    >
    <TextView
        android:layout_marginTop="20dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Quiz1"
        android:gravity="center"
        android:textColor="@color/white"
        android:textSize="20dp"
        android:textStyle="bold"/>

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:src="@drawable/n1"
        android:layout_marginBottom="20dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="Quel acteur incarne Geralt de Riv dans la série Netflix The Witcher"
        android:gravity="center"
        android:textSize="19dp"
        android:textStyle="bold"
        android:textColor="@color/white"/>
    <RadioGroup
        android:id="@+id/rg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
     <RadioButton
         android:id="@+id/rb1"
         android:textColor="@color/white"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="A) Younes mongo"/>
     <RadioButton
         android:textColor="@color/white"
         android:id="@+id/rb2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
         android:text="B) omar meftah "/>

        <RadioButton
            android:id="@+id/rb3"
            android:textColor="@color/white"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="C) amine rouiyess" />
        <RadioButton
            android:id="@+id/rb4"
            android:textColor="@color/white"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="D) amine naamani"/>
    </RadioGroup>
    <Button
        android:id="@+id/bNext"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Next"
        android:layout_marginTop="20dp"
        android:backgroundTint="@color/rouge"/>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center">

        <ImageView
            android:id="@+id/imageView2"
            android:layout_width="160dp"
            android:layout_height="40dp"
            android:layout_marginTop="40dp"
            android:gravity="center"
            app:srcCompat="@drawable/netflix"
            tools:layout_editor_absoluteX="105dp"
            tools:layout_editor_absoluteY="56dp" />
    </LinearLayout>

</LinearLayout>